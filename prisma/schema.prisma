generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Vercel 部署 = postgresql（Supabase）
  // 本地开发需要本地起一个 postgresql/mysql，DATABASE_URL 与此 provider 匹配即可
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  phone     String?  @unique
  role      String   @default("MEMBER")
  cityId    String?

  // ═══════ 智富积分资产（与 AssetBalance 联动，冗余字段方便快速查询） ═══════
  assetBalance Int @default(0) // 智富积分余额（冗余字段，与 AssetBalance.points 同步）

  // ═══════ 订阅模型（任务 1：阶梯式订阅 + 轻量级付费） ═══════
  // subscription_type 枚举：MONTHLY_69 / LIGHT_598 / DEEP_1980 / CITY_5980 / null（未订阅）
  subscription_type String? // 'MONTHLY_69', 'LIGHT_598', 'DEEP_1980', 'CITY_5980'
  // subscription_status 枚举：ACTIVE / TRIAL / CANCELED / EXPIRED
  subscription_status String  @default("INACTIVE")
  // OPC 诊断标记：付费 19.9 后置为 true
  opc_level           String?
  subscription_start  DateTime?
  subscription_end    DateTime?
  // 自动续费标记（仅 MONTHLY_69 适用）
  auto_renew          Boolean  @default(false)
  // 取消时间（用于记录用户主动取消时刻）
  canceled_at         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String     @id @default(cuid())
  title       String
  description String
  content     String
  category    String
  cityId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model City {
  id           String    @id @default(cuid())
  name         String    @unique
  code         String    @unique
  description  String?
  maintainerId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PartnerApplication {
  id        String   @id @default(cuid())
  name      String
  city      String
  phone     String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Salon {
  id          String     @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String
  maxCapacity Int        @default(50)
  status      String     @default("upcoming")
  cityId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model DiagnosisRequest {
  id          String   @id @default(cuid())
  name        String
  phone       String
  role        String   // 个人创业者/企业主/运营负责人
  goals       String?  @db.Text // JSON 字符串数组: 降本/获客/建团队 (MySQL 不支持 String[], 改用 JSON 字符串)
  description String   // 自由描述
  aiReport    String   @db.Text // 存储 AI 生成的诊断报告 Markdown
  status      String   @default("PENDING") // PENDING / CONTACTED / CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectPlanRequest {
  id           String   @id @default(cuid())
  name         String
  birthday     DateTime // 出生年月日，用于计算年龄和人生阶段
  targetIncome String   // 目标年收入（如："30万"）
  background   String   // 用户当下的职业背景介绍
  phone        String
  aiPlan       String   @db.Text // 存储 AI 生成的人生商业规划 Markdown
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ToolSubmission {
  id            String   @id @default(cuid())
  name          String
  description   String   @db.Text
  category      String   // 写作/绘画/视频/数字人
  officialUrl   String
  pricingModel  String   // 免费/订阅/买断
  affiliateLink String?  // 推广链接
  contactName   String?
  contactInfo   String?
  status        String   @default("PENDING")
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ServiceProvider {
  id          String   @id @default(cuid())
  name        String
  company     String?
  contact     String?
  city        String?  // 所属城市（OPC 专家入驻）
  userId      String?  // 关联 OPC 用户 ID
  specialty   String?  @db.Text // JSON 字符串数组: 内训/GEO/定制 (MySQL 不支持 String[], 改用 JSON 字符串)
  experience  String   @db.Text
  priceRange  String?
  isVerified  Boolean  @default(false)
  status      String   @default("PENDING") // PENDING/APPROVED/REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RevenueRecord {
  id            String   @id @default(cuid())
  source        String   // project/tool/service
  orderId       String?
  sellerId      String?
  sellerName    String?
  buyerId       String?
  buyerName     String?
  grossAmount   Float    // 总金额
  platformFee   Float    // 平台佣金
  sellerIncome  Float    // 服务商实收
  status        String   @default("PENDING") // PENDING/SETTLED/REFUNDED
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CommissionRecord {
  id             String   @id @default(cuid())
  orderId        String   // 关联订单
  sellerId       String   // 谁提供了资源（项目方/服务商）
  referrerId     String   // 谁推荐了这个客户（通常是主理人，城市ID）
  amount         Float    // 订单总金额
  commissionRate Float    // 抽成比例（如 0.2）
  commission     Float    // 结算佣金金额
  status         String   @default("PENDING") // PENDING / SETTLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════
// 统一订单表 (订单生成器 + 履约引擎 共用)
// 重构说明: 解耦"订单生成"与"履约执行", 引入经典三段式
//   前端 → POST /api/order/create (生成器) → 支付网关
//   支付网关 → POST /api/order/fulfill (履约引擎) → 业务动作
// ════════════════════════════════════════════════════════════════
model Order {
  id              String    @id @default(cuid())
  tenantId        String?   // 多租户预留 (未来可按租户分库分表)
  userId          String    // 关联 User.id (演示版用 opc_device_id)
  planKey         String    // 关联 PLAN_REGISTRY.key
  amount          Float     // 应付金额 (元)
  pointsUsed      Int       @default(0) // 使用的智富积分
  pointsDiscount  Float     @default(0) // 积分抵扣金额
  status          String    @default("pending") // pending / paid / refunded / failed / canceled
  provider        String    @default("mock")   // mock / stripe / polar / wechat / alipay
  providerOrderId String?   // 外部网关订单号 (Stripe/Polar 的 charge id, 方便对账)
  paidAt          DateTime? // 履约完成时间
  refundedAt      DateTime? // 退款时间
  // 业务参数透传 (如 cityCode 用于城市主理人)
  metadata        String?   @db.Text // JSON 字符串 (e.g. {"cityCode":"shenzhen","email":"x@y.com"})
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@index([planKey, status])
  @@index([provider, providerOrderId])
  @@index([createdAt])
}

// 智富积分资产账户（按手机号关联）
model AssetBalance {
  id          String   @id @default(cuid())
  phone       String   @unique // 关联用户手机号
  points      Int      @default(0) // 当前智富积分余额
  totalEarned Int      @default(0) // 历史累计赚取
  updatedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
}

// 智富积分流水（增/减 + 行为来源 · 防止作弊 & 查询历史）
model PointsLog {
  id        String   @id @default(cuid())
  userId    String   // 关联 User.id 或 opc_device_id（演示版）
  type      String   // 'SIGN_IN', 'TASK_COMPLETE', 'PURCHASE_BONUS', 'EXCHANGE_DISCOUNT', 'RENEWAL_BONUS', 'REFERRAL', 'SHARE', 'ADMIN_ADJUST'
  amount    Int      // 变动积分（正=收入 负=支出）
  balance   Int      // 变动后余额
  remark    String?  // 备注（如："完成AI数字网店第3步"）
  // 关联资源（可选）
  relatedId String?  // 关联业务单号（订单ID/任务ID/签到日期）
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// 良朋币流水（增/减 + 行为来源）
model CoinLedger {
  id        String   @id @default(cuid())
  phone     String   // 关联用户手机号
  action    String   // signin/salon/tool/diagnosis/plan/referral/purchase/redeem ...
  amount    Int      // 正数=收入 负数=支出
  balance   Int      // 变动后余额
  note      String?  // 备注
  createdAt DateTime @default(now())
}

// 用户偏好设置（按手机号关联）
model UserPreference {
  id         String   @id @default(cuid())
  userId     String   @unique // 关联用户手机号
  dailyBrief Boolean  @default(false) // 是否开启智能日报订阅
  updatedAt  DateTime @default(now())
}

// AI 智富日报（每日推送内容）
model DailyBrief {
  id          String   @id @default(cuid())
  userId      String   // 关联用户手机号
  content     String   @db.Text // AI 生成的日报 Markdown 内容
  isRead      Boolean  @default(false)
  generatedAt DateTime @default(now())
}

// 新手启航学习进度（OPC 4 步闭环：诊断 → 学习 → 实操 → 放大）
// 按手机号关联（与 AssetBalance / UserPreference 一致）
model LearningProgress {
  id                  String   @id @default(cuid())
  phone               String   @unique // 关联用户手机号
  opcLevel            String?  // 诊断的 OPC 类型: TRADER / FLOW / SYSTEM / ASSET
  // 3 大新手任务打卡（true = 已完成）
  task_browse         Boolean  @default(false) // 任务1: 浏览学习页面
  task_register       Boolean  @default(false) // 任务2: 注册网店 / 自媒体账号
  task_download       Boolean  @default(false) // 任务3: 下载配置首款 AI 工具
  // 累计得分（任务1: +20, 任务2: +40, 任务3: +40, 满分 100）
  learning_score      Int      @default(0)
  // 阶段解锁标志：learning_score >= 80 自动解锁"运营实操"阶段
  can_unlock_practice Boolean  @default(false)
  // 4 步路径状态
  step_diagnosis_done Boolean  @default(false) // STEP 01
  step_learning_done  Boolean  @default(false) // STEP 02（达到 80 分后自动 true）
  step_practice_done  Boolean  @default(false) // STEP 03
  step_scaleup_done   Boolean  @default(false) // STEP 04
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════
// 资源库 · OPC 共创 UGC 平台
// （任务1：资源投稿 + 互动，2026-07-15 良朋社升级）
// ════════════════════════════════════════════════════════════════

// 资源通用投稿表
// 允许投稿的分类：physical-prod / ai-software / ai-hardware / ai-courses
// 禁止投稿的分类：digital-prod（数字产品库）/ franchise（主理人招募）
model ResourceSubmission {
  id          String   @id @default(cuid())
  authorId    String   // 关联 User.id（必须是 OPC 注册用户）—— 演示版用 opc_device_id
  authorName  String?  // 投稿人昵称（冗余存储，避免 join）
  authorLevel String?  // 投稿时用户的 OPC 等级（TRADER/FLOW/SYSTEM/ASSET）
  title       String
  description String   @db.Text
  category    String   // 枚举：physical-prod / ai-software / ai-hardware / ai-courses
  fileUrl     String?  // 资源下载或跳转链接
  status      String   @default("PENDING") // PENDING / APPROVED / REJECTED
  rejectReason String? @db.Text // 驳回理由
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interactions ResourceInteraction[]

  @@index([category, status])
  @@index([authorId])
  @@index([createdAt])
}

// 资源互动表（评分、评论、实操笔记）
model ResourceInteraction {
  id         String   @id @default(cuid())
  resourceId String   // 关联 ResourceSubmission.id
  userId     String   // 互动者（演示版用 opc_device_id）
  userName   String?  // 互动者昵称（冗余存储）
  type       String   // 'COMMENT' / 'REVIEW' / 'NOTE'
  content    String   @db.Text
  rating     Int?     // 评分 1-5（仅 REVIEW 类型存在）
  createdAt  DateTime @default(now())

  resource ResourceSubmission @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, type])
  @@index([userId])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════
// 专家咨询线索池（任务 4：AI 助手"找专家"入口）
// 当用户在 /projects/[slug] SOP 流程中点击"📞 找专家"，
// 表单提交后写入本表，城市主理人 / 项目主理人可在后台跟进。
// ════════════════════════════════════════════════════════════════
model ConsultationRecord {
  id          String   @id @default(cuid())
  name        String                              // 客户姓名
  phone       String                              // 客户手机号
  projectSlug String                              // 当前项目 slug（路由 /projects/<slug>）
  projectTitle String?                            // 项目标题（冗余展示用）
  step        Int      @default(0)                // 当前步骤（1-indexed，0 表示未指明）
  stepTitle   String?                             // 当前步骤标题（可选）
  issue       String?  @db.Text                   // 用户填写的卡点描述
  source      String   @default("ai_assistant")   // 来源：ai_assistant / sop_card / manual 等
  status      String   @default("PENDING")        // PENDING / CONTACTED / CLOSED / INVALID
  city        String?                             // 城市（可选）
  userId      String?                             // 关联用户 ID（登录态）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectSlug])
  @@index([status])
  @@index([createdAt])
}

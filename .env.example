# ============================================
# 良朋社 OPC · Vercel 部署环境变量模板
# ============================================
# 用法：复制本文件为 .env.local（本地开发）
#      或在 Vercel Dashboard → Settings → Environment Variables 中逐项添加
# ============================================

# ===== Supabase 配置 =====
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===== Prisma 数据库连接 (Supabase PostgreSQL) =====
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ===== Dify AI · 通用 key (必需) =====
DIFY_API_KEY=your_dify_api_key
DIFY_APP_BASE_URL=https://api.dify.ai/v1

# ===== Dify AI · 各场景专用 key (可选，未设置时降级到 DIFY_API_KEY) =====
DIFY_API_KEY_DIAGNOSE=           # 1v1 商业诊断
DIFY_API_KEY_TOOL=               # 工具推荐
DIFY_API_KEY_DAILY=              # AI 智富日报
DIFY_API_KEY_SOP_IMAGE=          # SOP 简图生成
DIFY_API_KEY_PRACTICE=           # 实战脚本
DIFY_API_KEY_CHAT=               # 通用对话
DIFY_API_KEY_PLAN=               # 项目计划
DIFY_API_KEY_COACH=              # AI 教练
DIFY_API_KEY_PULSE=              # 社区心跳
DIFY_API_KEY_CITY=               # 城市日报
DIFY_API_KEY_SEO=                # SEO/GEO 文案

# ===== Polar 支付 (订阅/主理人漏斗) =====
POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret
POLAR_ORGANIZATION_ID=your_polar_org_id

# ===== NextAuth (如使用) =====
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your_nextauth_secret

# ===== 应用配置 =====
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_TELEMETRY_DISABLED=1
